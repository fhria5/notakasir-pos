<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp">
        <TextView style="@style/Text.Notakasir.Headline" android:text="Pembayaran"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv_total" style="@style/Text.Notakasir.Body"
            android:text="Total Rp0" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <RadioGroup android:id="@+id/rg_method" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <RadioButton android:id="@+id/rb_cash" android:text="Tunai" android:checked="true"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/rb_qris" android:text="QRIS"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </RadioGroup>
        <GridLayout android:id="@+id/grid_nominal" android:columnCount="3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Nominal bayar (Rp)" android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_paid" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tv_change" style="@style/Text.Notakasir.Body"
            android:text="Kembalian Rp0" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <Button android:id="@+id/btn_confirm" android:text="Konfirmasi Bayar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
