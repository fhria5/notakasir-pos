<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp">
        <TextView style="@style/Text.Notakasir.Headline" android:text="Struk"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv_receipt" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:typeface="monospace"
            android:layout_marginTop="12dp" android:textSize="13sp" />
        <Button android:id="@+id/btn_print" android:text="Cetak (Bluetooth)"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <Button android:id="@+id/btn_kitchen" android:text="Cetak Tiket Dapur"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_wa" android:text="Kirim via WhatsApp"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_done" android:text="Transaksi Baru"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
