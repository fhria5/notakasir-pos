<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Notakasir.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Notakasir</item>
    </style>

    <style name="Theme.Notakasir" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/card</item>
        <item name="materialButtonStyle">@style/Btn.Notakasir</item>
        <item name="materialCardViewStyle">@style/Card.Notakasir</item>
    </style>

    <style name="Btn.Notakasir" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Card.Notakasir" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius</item>
    </style>

    <style name="Text.Notakasir.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Notakasir.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Notakasir.Muted" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
